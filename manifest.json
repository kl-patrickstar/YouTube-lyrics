{
  "manifest_version": 3,
  "name": "YouTube Lyrics",
  "version": "1.0.0",
  "description": "Shows synced lyrics for YouTube videos in a floating panel.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://lrclib.net/*",
    "https://api.lyrics.ovh/*",
    "https://itunes.apple.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Lyrics"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Show or hide the YouTube Lyrics panel"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "state.js",
        "bridge.js",
        "lyrics.js",
        "api.js",
        "youtube.js",
        "sync.js",
        "template.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
